# Starship Prompt Configuration
# Displays directory, Git branch/status, command duration, and exit status

# Prompt layout & options
add_newline = false

format = """
$username\
$hostname\
$directory\
$git_branch\
$git_status\
$cmd_duration\
$line_break\
$character"""

right_format = """$status"""

# Active color palette (must be defined in root table before module tables)
palette = "catppuccin_mocha"

# Prompt symbol
[character]
success_symbol = "[➜](bold green)"
error_symbol = "[✗](bold red)"

# Directory styling
[directory]
truncation_length = 0
truncate_to_repo = false
style = "lavender"
read_only = " 🔒"

# Git branch
[git_branch]
symbol = " "
style = "bold mauve"
format = "[$symbol$branch]($style) "

# Git status
[git_status]
style = "bold red"
format = '([\[$all_status$ahead_behind\]]($style) )'
conflicted = "󰞇 "
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇕⇡${ahead_count}⇣${behind_count}"
untracked = ""
stashed = "📦"
modified = "!"
staged = "+"
renamed = "»"
deleted = "✘"

# Command execution duration
[cmd_duration]
min_time = 2_000
format = "took [$duration]($style) "
style = "yellow"

# Exit status code
[status]
disabled = false
format = '[$symbol$status]($style)'
symbol = "exit "
style = "bold red"

# Username & Hostname
[username]
show_always = false
style_user = "bold blue"
style_root = "bold red"
format = "[$user]($style)@"

[hostname]
ssh_only = true
style = "bold yellow"
format = "[$hostname]($style):"

# Catppuccin Mocha color palette definition
[palettes.catppuccin_mocha]
rosewater = "#f5e0dc"
flamingo = "#f2cdcd"
pink = "#f5c2e7"
mauve = "#cba6f7"
red = "#f38ba8"
maroon = "#eba0ac"
peach = "#fab387"
yellow = "#f9e2af"
green = "#a6e3a1"
teal = "#94e2d5"
sky = "#89dceb"
sapphire = "#74c7ec"
blue = "#89b4fa"
lavender = "#b4befe"
text = "#cdd6f4"
subtext1 = "#bac2de"
subtext0 = "#a6adc8"
overlay2 = "#9399b2"
overlay1 = "#7f849c"
overlay0 = "#6c7086"
surface2 = "#585b70"
surface1 = "#45475a"
surface0 = "#313244"
base = "#1e1e2e"
mantle = "#181825"
crust = "#11111b"

